{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb"],
    "category": "Music",
    "shortDescription": "A lightweight native YouTube Music client",
    "longDescription": "Cremeplay is a lightweight YouTube Music desktop client built with Tauri, Rust and a vanilla TypeScript frontend.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libasound2"],
        "recommends": [
          "pipewire-alsa",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      }
    }
  }
}
